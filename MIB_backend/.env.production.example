# Production environment for https://www.myintellibook.com
# Copy to the server as MIB_backend/.env (chmod 600, owned by the web user), fill in every
# <placeholder>, then run: php artisan key:generate (first deploy only), php artisan migrate --force,
# php artisan config:cache, php artisan route:cache. Never commit the real file.

APP_NAME=MyIntellibook
APP_ENV=production
APP_KEY=<generate with php artisan key:generate>
APP_DEBUG=false
APP_URL=https://www.myintellibook.com
FRONTEND_URL=https://www.myintellibook.com

# Links placed in emails. The app appends "?email=...&token=..." to the verification URL
# and ":<token>" to the reset URL, matching the frontend routes.
EMAIL_VERIFICATION_URL=https://www.myintellibook.com/emailVerified
PASSWORD_RESET_URL=https://www.myintellibook.com/password/reset/

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Least-privilege database user (not root): SELECT, INSERT, UPDATE, DELETE on this database only.
# Run migrations with a separate migration user, or grant DDL only while migrating.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<app_user>
DB_PASSWORD=<strong random password>

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@myintellibook.com
MAIL_FROM_NAME="MyIntellibook"

GOOGLE_CLIENT_ID=<google oauth web client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>
GOOGLE_REDIRECT=https://www.myintellibook.com/api/auth/google/callback

# Security hardening (defaults shown)
TOKEN_EXPIRES_AT=8
ADMIN_TOKEN_EXPIRES_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_EXPIRES_MINUTES=60